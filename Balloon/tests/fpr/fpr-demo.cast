[43.370928, "o", "\r\n\u001b[1;36m===================================================\r\n  4. commit safety net: untouched-commit pressure\r\n===================================================\u001b[0m\r\n"]
[44.372143, "o", "  reserving 600 MB of pure commit charge (no physical pages):\r\n"]
[45.463842, "o", "\r\r\n  headroom now: 1146 MB (threshold: RAM/10 = 410 MB)\r\r\n"]
[49.345434, "o", "\r\r\n  headroom after the release: 1380 MB\r\r\n"]
[49.34652, "o", "\r\n\u001b[1;36m===================================================\r\n  5. feature negotiation (QEMU view)\r\n"]
[49.346546, "o", "===================================================\u001b[0m\r\n"]
[50.377603, "o", "      \"dev-features\": [\r\n\r\n      ],\r\n      \"transports\": [\r\n\r\n      ]\r\n    },\r\n--\r\n"]
[50.377759, "o", "\r\n\u001b[1;36m===================================================\r\n  summary\r\n"]
[50.377778, "o", "===================================================\u001b[0m\r\n"]
[51.378761, "o", "  - 2.6 GB of guest free memory parked at the host        (demo 1)\r\n  - full release within ~1s of guest pressure              (demo 2)\r\n  - cooldown then automatic re-park                        (demo 3)\r\n  - commit headroom guarded at RAM/10                      (demo 4)\r\n\r\n\u001b[1;32m  Free page reporting: valuable for the host, safe for the guest.\u001b[0m\r\n\r\n"]
