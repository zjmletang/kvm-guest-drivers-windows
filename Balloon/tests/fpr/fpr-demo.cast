{"version": 2, "width": 80, "height": 24, "timestamp": 1789638454, "env": {"SHELL": "/bin/bash", "TERM": null}, "title": "virtio-balloon FPR live demo"}
[0.059738, "o", "\r\n\u001b[1;36m===================================================\r\n  virtio-balloon Free Page Reporting - live demo\r\n===================================================\u001b[0m\r\n"]
[1.060682, "o", "  host: bare metal + QEMU 9.2 + libvirt\r\n  guest: Windows 11 x64, 4GB RAM, balloon 58707\r\n  FPR feature: negotiated (VIRTIO_BALLOON_F_PAGE_REPORTING)\r\n\r\n\u001b[1;36m===================================================\r\n  1. park steady state: FPR holds the guest's free memory\r\n"]
[1.060727, "o", "===================================================\u001b[0m\r\n"]
[2.0617, "o", "  QEMU process RSS (host physical for this guest):\r\n"]
[2.06388, "o", "    1531 MB   (guest RAM is 4096 MB - most of it returned to the host)\r\n"]
[3.066967, "o", "    1531 MB   (guest RAM is 4096 MB - most of it returned to the host)\r\n"]
[4.070227, "o", "    1531 MB   (guest RAM is 4096 MB - most of it returned to the host)\r\n"]
[5.073224, "o", "    1531 MB   (guest RAM is 4096 MB - most of it returned to the host)\r\n"]
[6.074136, "o", "\r\n\u001b[1;36m===================================================\r\n  2. guest pressure: an app eats 2.8 GB now\r\n===================================================\u001b[0m\r\n"]
[7.683624, "o", "pressure started\r\r\n"]
[7.684909, "o", "\r\n"]
[7.684928, "o", "  watching the host RSS every second (low-memory event releases the pages):\r\n"]
